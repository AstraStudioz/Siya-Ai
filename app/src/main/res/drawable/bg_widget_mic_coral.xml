<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft halo ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_mic_ring_outer" />
        </shape>
    </item>
    <!-- Inner coral gradient circle with delicate highlight border -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/widget_mic_coral_start"
                android:endColor="@color/widget_mic_coral_end"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_mic_ring_inner" />
        </shape>
    </item>
</layer-list>
