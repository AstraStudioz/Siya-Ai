<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass_22dp"
    android:clickable="true"
    android:contentDescription="@string/widget_desc_voice_action"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- Coral glowing mic button -->
    <FrameLayout
        android:id="@+id/btn_voice_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_widget_mic_coral"
        android:clickable="true"
        android:contentDescription="@string/widget_desc_voice_action"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_mic_white" />
    </FrameLayout>

    <!-- Center text labels -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_tap_to_talk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_tap_to_talk"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_voice_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/widget_brand_name"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Right side waveform & sparkle -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="end"
            android:layout_marginBottom="2dp"
            android:src="@drawable/ic_widget_sparkle" />

        <ImageView
            android:id="@+id/iv_waveform"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_desc_waveform"
            android:src="@drawable/ic_widget_waveform" />
    </LinearLayout>
</LinearLayout>
