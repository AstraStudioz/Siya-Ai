<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_card"
    android:padding="20dp">

    <!-- Header with Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jarvis_icon_square">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_bell"
                app:tint="?attr/themeAccent"
                android:contentDescription="Update Icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvUpdateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New update available"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpdateVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0.147 (Build 147)"
                android:textColor="?attr/themeAccent"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Changelog Container -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WHAT&apos;S NEW"
        android:textColor="?attr/themeTextMuted"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="180dp"
        android:background="@drawable/bg_input_field"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvUpdateChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Performance improvements\n• Bug fixes and neural model enhancements"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans-serif" />
    </androidx.core.widget.NestedScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnUpdateLater"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="Later"
            android:textColor="?attr/themeTextMuted"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnUpdateDownloadNow"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_jarvis_pill_button"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Download now"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Skip this version -->
    <TextView
        android:id="@+id/tvSkipVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skip this version"
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:padding="6dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
